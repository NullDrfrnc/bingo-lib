{
	"schemaVersion": 1,
	"id": "bingolib",
	"version": "${version}",
	"name": "BingoLib",
	"description": "A library and mod to create, use and play bingo's in minecraft",
	"authors": [
		"<null/>"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/bingolib/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.nullptrexc.bingolib.BingoLib"
		],
		"client": [
			"com.nullptrexc.bingolib.client.BingoLibClient"
		],
		"fabric-datagen": [
			"com.nullptrexc.bingolib.datagen.BingoLibDataGenerator"
		]
	},
	"mixins": [
		"bingolib.mixins.json",
		{
			"config": "bingolib.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}